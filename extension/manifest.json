{
  "manifest_version": 3,
  "name": "LinkCard",
  "version": "0.1.0",
  "description": "Generate a social media ready preview card and message for the article you are reading.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "LinkCard",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Open LinkCard for this page"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "linkcard@caevus.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
