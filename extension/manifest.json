{
  "manifest_version": 3,
  "name": "Linkcard",
  "version": "0.1.0",
  "description": "Make a Discord-ready Card and Message for the article you are reading.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Linkcard",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Open Linkcard for this page"
    }
  },
  "browser_specific_settings": {
    "gecko": { "id": "linkcard@caevus.github.io", "strict_min_version": "113.0" }
  }
}
